# 신용평가서 PDF가 모여 있는 폴더 (필수)
INPUT_DIR=여기입력

# 상품·라벨 딕셔너리 YAML 폴더와 파일명
INSTRUMENTS_YAML_PATH=config/instruments.yaml

# Excel·JSON 결과 폴더
RESULT_DIR=results

# SQLite DB 결과 폴더와 파일명
DOCUMENT_DB_PATH=admin/data/documents.db

# YAML 백업 폴더
ADMIN_BACKUP_DIR=admin/backup

# PDF당 스캔할 최대 페이지 수
MAX_PDF_PAGES=1

# 텍스트 추출 실패 판정: 행이 없고 추출 문자 수가 이 값 미만이며 등급 토큰이 0개일 때
MIN_EXTRACTED_TEXT_CHARS=50
