# 처리할 PDF가 모여 있는 폴더 (필수, 코드 기본값 없음)
# 상대경로: CreditRateFinder / 앱 루트 기준 / 절대경로도 가능
INPUT_DIR=여기입력

# instruments.yaml 등이 있는 설정 폴더
CONFIG_DIR=config

# 상품·라벨 딕셔너리 YAML 파일명 (CONFIG_DIR 아래)
INSTRUMENTS_YAML=instruments.yaml

# Excel·JSON 결과 저장 폴더
RESULT_DIR=result

# 결과 파일명 접두어 → {접두어}_YYYYMMDD.json / .xlsx
RESULT_FILENAME_PREFIX=result

# 관리용 폴더 (undefined.json 등)
ADMIN_DIR=admin

# undefined 라벨 누적 파일명 (ADMIN_DIR 아래)
UNDEFINED_JSON=undefined.json

# PDF당 스캔할 최대 페이지 수
MAX_PDF_PAGES=3

# 텍스트 추출 실패 판정: 행이 없고 추출 문자 수가 이 값 미만이며 등급 토큰이 0개일 때
MIN_EXTRACTED_TEXT_CHARS=50

# 결과 ID 접두어 (예: R000001)
RESULT_ID_PREFIX=R

# 결과 ID 숫자 자릿수 (zero-pad)
RESULT_ID_WIDTH=6
